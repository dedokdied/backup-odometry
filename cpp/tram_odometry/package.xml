<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tram_odometry</name>
  <version>0.1.0</version>
  <description>
    Model-based fallback odometry for a tram: estimates longitudinal velocity and
    MGRS/UTM position from driver controller position and front/rear bogie wheel
    speeds only, without GNSS/IMU, with online slip detection and model adaptation.
  </description>

  <maintainer email="antoniostruchkovio@yandex.ru">Struchkov Anton</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>yaml_cpp_vendor</depend>
  <depend>tram_vehicle_msgs</depend>

  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
